/.venv*/
/.claude/
/.opencode/
/.ruff_cache/
/.pytest_cache/
/.ladder_credentials
/.ladder_exit_password
/.ladder_exit_r1_credentials
/.ladder_r2_credentials

__pycache__/
target/
*.log
*.out
*.pid

# Local production artifacts. Their required hashes are in
# results/accepted-r1/artifacts.json.
/srcs/models/
/srcs/runtime/*
!/srcs/runtime/.gitkeep
/srcs/vendor/foul-play/
/srcs/vendor/metamon/

# Historical local dependencies and generated research payloads. Files already
# tracked in the archive remain tracked; these rules prevent new run artifacts
# from being added accidentally.
/experimental/external/
/experimental/data/**
/experimental/runs/**
!/experimental/runs/README.md
!/experimental/runs/iteration_log.md
/experimental/src/external/
/experimental/src/nets/checkpoints/**
/experimental/engine/**/linux_wheels/
/experimental/engine/**/docs/make.bat

# model checkpoints never belong in git (GitHub 100MB limit)
experimental/releases/**/*.pt
*.pt

# build caches and machine-local dirs
/experimental/.cargo-gen9-learned-priors/
/output/
/tmp/
/external/
/experimental/cache/

# raw run logs stay on disk (and in archives), out of git
experimental/runs/**/logs/
experimental/runs/**/registrations/
experimental/runs/**/*.log
experimental/runs/**/*protocol.jsonl
experimental/runs/**/*search.jsonl
experimental/runs/**/*holdout.jsonl
experimental/runs/**/raw_logs.tar.gz
