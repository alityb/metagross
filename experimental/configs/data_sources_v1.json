  "training_stages": [
    {
      "id": "gen9_representation_warm_start",
      "purpose": "Learn public battle dynamics and a human-strategy prior before expensive search labeling.",
      "sources": [
        {"id": "metamon_human_v6", "weight": 0.70, "format_filter": ["gen9ou"], "objectives": ["masked_representation", "behavior_cloning", "terminal_value"]},
        {"id": "local_human_randbats", "weight": 0.30, "format_filter": ["gen9randombattle"], "objectives": ["masked_representation", "behavior_cloning", "terminal_value"]}
      ],
      "rules": [
        "Sample at most 500,000 Metamon POV trajectories for the first warm start; scale only after an ablation.",
        "Inputs contain only the acting player's information state.",
        "Do not use reconstructed opponent hidden sets as labels."
      ]
    },
    {
      "id": "gen9randombattle_primary_multitask",
      "purpose": "Train the deployable format-matched policy and information-state value heads.",
      "sources": [
        {"id": "local_human_randbats", "weight": 0.40, "format_filter": ["gen9randombattle"], "objectives": ["behavior_cloning", "policy_anchor", "terminal_value"]},
        {"id": "local_search_teacher_history", "weight": 0.40, "format_filter": ["gen9randombattle"], "objectives": ["search_policy", "q_advantage", "uncertainty"]},
        {"id": "local_league_g5", "weight": 0.20, "format_filter": ["gen9randombattle"], "objectives": ["terminal_value", "policy_behavior"]}
      ],
      "rules": [
        "Replace the historical search source with a fresh 25,000-50,000-root stratified teacher corpus before promotion training.",
        "Retain human examples in every batch and regularize the policy toward the frozen human warm start.",
        "Search targets include visit distributions, Q advantages, independent seeds, and uncertainty; selected actions alone are insufficient.",
        "Terminal outcomes remain the non-circular value target."
      ]
    }
  ],
  "minimum_new_data": {
